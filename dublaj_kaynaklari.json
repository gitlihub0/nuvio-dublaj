{
  "schemaVersion": 1,
  "autoSearch": false,
  "providers": [
    {
      "id": "fullhdfilmizlesene",
      "enabled": true,
      "audioDelayMs": 0,
      "label": "Türkçe Dublaj · FullHD",
      "lang": "tr",
      "base": "https://www.fullhdfilmizlesene.now",
      "audioHeaders": {
        "Origin": "{base}",
        "Referer": "{base}/"
      },
      "movie": {
        "stopOnImdbMatch": true,
        "queries": [
          "{imdb}",
          "{title} {year}",
          "{title_tmdb} {year}"
        ]
      },
      "search": {
        "url": "{base}/arama/{q}",
        "maxCandidates": 3,
        "pick": [
          "<li[^>]*class=\"[^\"]*\\bfilm\\b[^\"]*\"[^>]*>(?:(?!</li>).)*?<a[^>]+href=\"([^\"]+)\""
        ]
      },
      "steps": [
        {
          "op": "http_get",
          "url": "{page}",
          "referer": "{base}/",
          "as": "html"
        },
        {
          "op": "check",
          "from": "html",
          "pattern": "(?:imdb\\.com/title/|imdb_?id[\\\"']?\\s*[:=]\\s*[\\\"']?)(tt\\d+)",
          "ignoreCase": true,
          "expect": "imdb"
        },
        {
          "op": "check",
          "from": "html",
          "pattern": "<title>[^<]*\\((\\d{4})\\)</title>",
          "expect": "year",
          "tolerance": 1,
          "required": true,
          "skipIfImdbVerified": true
        },
        {
          "op": "regex",
          "from": "html",
          "pattern": "scx\\s*=\\s*(\\{.*?\\})\\s*;",
          "dotAll": true,
          "group": 1,
          "as": "scx"
        },
        {
          "op": "json_path",
          "from": "scx",
          "path": "atom.sx.t[0]"
        },
        {
          "op": "rot13"
        },
        {
          "op": "base64",
          "as": "player"
        },
        {
          "op": "http_get",
          "url": "{player}",
          "referer": "{base}/",
          "as": "playerHtml"
        },
        {
          "op": "regex",
          "from": "playerHtml",
          "group": 1,
          "patterns": [
            "_p8\\s*=\\s*['\"]([^'\"]+)['\"]",
            "\\bav\\('([^']+)'\\)"
          ]
        },
        {
          "op": "reverse"
        },
        {
          "op": "base64",
          "charset": "latin1"
        },
        {
          "op": "shift_key",
          "key": "K9L",
          "mod": 5,
          "add": 1,
          "dir": "sub"
        },
        {
          "op": "base64",
          "charset": "utf-8",
          "as": "decoded"
        },
        {
          "op": "regex",
          "from": "decoded",
          "group": 1,
          "as": "audioUrl",
          "patterns": [
            "(https://[^\"'\\s\\\\]+?tra\\d+)(?=[\"'\\s,}\\\\]|$)",
            "[\"']?cm[\"']?\\s*:\\s*[\"']([^\"']+)[\"']",
            "(https://[^\"'\\s\\\\]+)"
          ]
        },
        {
          "op": "replace",
          "from": "audioUrl",
          "pattern": "^(https://[^/]+/m)([a-z])(/.*)ena2$",
          "with": "\\1\\2\\3tra1",
          "shift": [
            {
              "group": 2,
              "delta": 1
            }
          ],
          "as": "audioUrl"
        },
        {
          "op": "replace",
          "from": "audioUrl",
          "pattern": "^(https://[^/]+/m)([a-z])(/.+)avr1$",
          "with": "\\1\\2\\3vr1b1080l0tra1",
          "shift": [
            {
              "group": 2,
              "delta": 5
            }
          ],
          "as": "audioUrl"
        },
        {
          "op": "replace",
          "from": "audioUrl",
          "pattern": "^(https://[^/]+/m)([a-z])(/.+vr1)$",
          "with": "\\1\\2\\3b1080l0tra1",
          "shift": [
            {
              "group": 2,
              "delta": 5
            }
          ],
          "as": "audioUrl"
        },
        {
          "op": "require",
          "from": "audioUrl",
          "pattern": "tra\\d+$"
        },
        {
          "op": "hls_audio",
          "from": "audioUrl",
          "lang": "tr",
          "as": "audioFinal"
        }
      ],
      "result": "audioFinal"
    },
    {
      "id": "dizigom-dizi",
      "enabled": true,
      "audioDelayMs": 0,
      "label": "Türkçe Dublaj · Dizigo",
      "lang": "tr",
      "base": "https://www.dizigom.news",
      "audioHeaders": {
        "Origin": "{base}",
        "Referer": "{base}/"
      },
      "series": {
        "queries": [
          "{title}",
          "{title_tmdb}"
        ]
      },
      "search": {
        "url": "{base}/ara?q={q}",
        "maxCandidates": 3,
        "pick": [
          "href=\"(https://www\\.dizigom\\.news/diziler/[^\"/]+/?)\""
        ]
      },
      "steps": [
        {
          "op": "regex",
          "from": "page",
          "pattern": "/diziler/([a-z0-9-]+?)(?:-izle)?/?$",
          "group": 1,
          "as": "seriesSlug"
        },
        {
          "op": "set",
          "value": "{title}",
          "as": "titleSlug"
        },
        {
          "op": "replace",
          "from": "titleSlug",
          "pattern": "['’`]",
          "with": "",
          "as": "titleSlug"
        },
        {
          "op": "replace",
          "from": "titleSlug",
          "pattern": "[^A-Za-z0-9]+",
          "with": "-",
          "as": "titleSlug"
        },
        {
          "op": "replace",
          "from": "titleSlug",
          "pattern": "^-+|-+$",
          "with": "",
          "as": "titleSlug"
        },
        {
          "op": "regex",
          "from": "seriesSlug",
          "pattern": "^{titleSlug}(?:-izle)?(?:-(?:hd\\d*|md|us|uk|\\d{4}))?$",
          "ignoreCase": true,
          "group": 0,
          "as": "slugOk"
        },
        {
          "op": "set",
          "value": "{base}/{seriesSlug}-{season}-sezon-{episode}-bolum/",
          "as": "episodeUrl"
        },
        {
          "op": "http_get",
          "url": "{episodeUrl}",
          "referer": "{page}",
          "headers": {},
          "as": "html"
        },
        {
          "op": "regex",
          "from": "html",
          "group": 1,
          "as": "playerRaw",
          "ignoreCase": true,
          "patterns": [
            "<iframe[^>]+src=\"(https://[a-z0-9.]*pilavyerplay\\.top/assets/js/s\\.php\\?s=[^\"]+)\"",
            "(data-pv=\"[^\"]+\"[^>]*>\\s*</div>\\s*<script[^>]*\\ssrc=\"https://[^\"/]+/assets/js/core\\.js)"
          ]
        },
        {
          "op": "replace",
          "from": "playerRaw",
          "pattern": "^data-pv=\"([^\"]+)\"[\\s\\S]*?src=\"(https://[^\"/]+)/assets/js/core\\.js$",
          "with": "\\2/assets/js/s.php?s=\\1",
          "as": "playerUrl"
        },
        {
          "op": "http_get",
          "url": "{playerUrl}",
          "referer": "{base}/",
          "headers": {},
          "as": "playerHtml"
        },
        {
          "op": "regex",
          "from": "playerHtml",
          "pattern": "__PLAYER__\\s*=\\s*(\\{.*?\\})\\s*;?\\s*</script>",
          "dotAll": true,
          "group": 1,
          "as": "playerJson"
        },
        {
          "op": "json_path",
          "from": "playerJson",
          "path": "stream",
          "as": "masterUrl"
        },
        {
          "op": "http_get",
          "url": "{masterUrl}",
          "referer": "{base}/",
          "headers": {},
          "as": "masterText"
        },
        {
          "op": "regex",
          "from": "masterText",
          "group": 1,
          "as": "audioUri",
          "patterns": [
            "#EXT-X-MEDIA:[^\\n]*TYPE=AUDIO[^\\n]*LANGUAGE=\"tr[^\"]*\"[^\\n]*URI=\"([^\"]+)\"",
            "#EXT-X-MEDIA:[^\\n]*TYPE=AUDIO[^\\n]*URI=\"([^\"]+)\"[^\\n]*LANGUAGE=\"tr",
            "^(?![\\s\\S]*#EXT-X-MEDIA:[^\\n]*LANGUAGE=)[\\s\\S]*?#EXT-X-MEDIA:[^\\n]*TYPE=AUDIO[^\\n]*URI=\"([^\"]+)\""
          ]
        },
        {
          "op": "replace",
          "from": "masterUrl",
          "pattern": "^(https?://[^?#]*/)[^/?#]*(?:\\?.*)?$",
          "with": "\\1",
          "as": "masterDir"
        },
        {
          "op": "set",
          "value": "{masterDir}{audioUri}",
          "as": "audioFinal"
        }
      ],
      "result": "audioFinal"
    },
